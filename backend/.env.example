# SentinelIQ Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# See docs/git-and-ec2-setup.md for setup instructions.

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
APP_NAME=SentinelIQ
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://sentineliq:changeme@localhost:5432/sentineliq
DATABASE_URL_SYNC=postgresql://sentineliq:changeme@localhost:5432/sentineliq

# =============================================================================
# SECURITY / AUTH
# =============================================================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional seed users are disabled by default. For a temporary interactive
# environment, opt in explicitly and inject unique passwords through the
# deployment secret store. Never commit populated values. Rerunning the seed
# does not reactivate, reset, or change roles on an existing account.
SEED_INTERACTIVE_OPERATOR_ENABLED=false
SEED_INTERACTIVE_OPERATOR_EMAIL=
SEED_INTERACTIVE_OPERATOR_PASSWORD=
SEED_INTERACTIVE_ADMIN_ENABLED=false
SEED_INTERACTIVE_ADMIN_EMAIL=
SEED_INTERACTIVE_ADMIN_PASSWORD=

# =============================================================================
# PATH B — IBM watsonx Orchestrate SaaS (primary — activates when ORCHESTRATE_URL is set)
# =============================================================================
# Full tenant URL of your watsonx Orchestrate instance.
# Allowed SaaS formats (HTTPS/443 only; no query, fragment, or credentials):
#   https://<tenant>.ibm-watson-orchestrate.com[/instances/<instance-id>]
#   https://<region>.watson-orchestrate.cloud.ibm.com[/instances/<instance-id>]
# Leave empty → agent services use the deterministic safety fallback.
ORCHESTRATE_URL=
# IBM Cloud API key — exchanged for a short-lived IAM bearer token.
ORCHESTRATE_API_KEY=
# SaaS direct-agent runtime version (verified against the live tenant).
ORCHESTRATE_API_VERSION=v1
# Deployed agent UUIDs from the target Orchestrate environment. Import and deploy
# each agent, then copy its environment-specific UUID; display names do not work
# with the runtime endpoint. Path B startup validation requires all four UUIDs.
ORCHESTRATE_TRIAGE_AGENT_ID=
ORCHESTRATE_CONTEXT_AGENT_ID=
ORCHESTRATE_EXPLANATION_AGENT_ID=
ORCHESTRATE_COORDINATOR_AGENT_ID=
# OAuth2 client credentials for Orchestrate's team connection to the approved
# read-only agent tools. Generate both values outside source control; the secret
# must be at least 32 characters and is stored only in the deployment secret
# store and the Orchestrate connection credential vault.
ORCHESTRATE_TOOLS_CLIENT_ID=
ORCHESTRATE_TOOLS_CLIENT_SECRET=

# =============================================================================
# IBM watsonx.ai embeddings (knowledge retrieval only)
# =============================================================================
# Base URL for the watsonx.ai ML API (us-south region — verified 2026-11-05)
# HTTPS/443 IBM Cloud regional endpoint only; no path, query, fragment, or credentials.
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com
# IBM Cloud API key used only for the embeddings endpoint.
WATSONX_API_KEY=
# Space ID — MUST have a Watson Machine Learning instance associated.
WATSONX_SPACE_ID=
# Retrieval embedding model. No direct chat-generation fallback is configured.
WATSONX_EMBEDDING_MODEL_ID=ibm/slate-30m-english-rtrvr

# =============================================================================
# Agent invocation config
# =============================================================================
AGENT_INVOKE_TIMEOUT=45.0
AGENT_MAX_RETRIES=1

# =============================================================================
# BACKWARDS COMPAT (deprecated — will be removed at Gate 20)
# These map to WATSONX_BASE_URL / WATSONX_SPACE_ID if set.
# =============================================================================
# ORCHESTRATE_BASE_URL=https://us-south.ml.cloud.ibm.com
# ORCHESTRATE_SPACE_ID=5ff3e395-6818-4f50-8123-5c3cd631e691

# =============================================================================
# CORS
# =============================================================================
# Comma-separated string — the config validator splits on commas automatically.
# Do NOT use JSON array format here (pydantic-settings v2 JSON-parses lists
# before the field_validator runs, which causes a parse error on plain strings).
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Leave commented out to use the built-in default above.

# =============================================================================
# EVENT PROCESSING
# =============================================================================
# Deduplication window in seconds
EVENT_DEDUP_WINDOW_SECONDS=300
# Maximum time window for access correlation (minutes)
ACCESS_CORRELATION_WINDOW_MINUTES=10
# Default retrieval limits
MAX_INCIDENT_HISTORY_RESULTS=10
MAX_EVIDENCE_AGE_HOURS=24

# =============================================================================
# RISK ENGINE
# =============================================================================
# Active risk policy version (matches risk_policies table)
ACTIVE_RISK_POLICY_VERSION=1.0

# =============================================================================
# CONFIDENCE ENGINE
# =============================================================================
# Minimum confidence to auto-clear (below this → human review required)
MIN_CONFIDENCE_AUTO_CLEAR=0.85

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_SEMANTIC_SEARCH=true
ENABLE_AGENT_TRACING=true
ENABLE_RATE_LIMITING=true
# Enable only for controlled, non-production Gate 23 validation. Production
# startup rejects this setting when true.
ENABLE_SIMULATOR_API=false

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_EVENTS_PER_MINUTE=100
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
MAX_REQUEST_BODY_BYTES=1048576
EVENT_RAW_METADATA_MAX_BYTES=16384
EVENT_RAW_METADATA_MAX_DEPTH=5
EVENT_RAW_METADATA_MAX_KEYS=64
EVENT_RAW_METADATA_MAX_ITEMS=100
EVENT_RAW_METADATA_MAX_STRING_BYTES=2048

# =============================================================================
# OBSERVABILITY
# =============================================================================
ENABLE_STRUCTURED_LOGGING=true
ENABLE_REQUEST_LOGGING=true
# Optional: OpenTelemetry endpoint
OTEL_ENDPOINT=

# =============================================================================
# STORAGE
# =============================================================================
# For thumbnails/media (MVP uses local filesystem)
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_PATH=/app/media
