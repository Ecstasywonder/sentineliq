# Docker Compose interpolation variables. Copy to the repository-root `.env`
# (which is gitignored) or export them in your shell before `docker compose up`.
# Generate a unique value; never use a documented/default password.
POSTGRES_PASSWORD=replace-with-a-random-long-password

# Services bind only to localhost by default. Use a reverse proxy for any
# remotely reachable deployment; do not change these to 0.0.0.0 casually.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
