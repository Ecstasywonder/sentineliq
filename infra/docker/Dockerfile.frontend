# Versioned base tags avoid silently consuming a moving `slim`/`alpine` tag.
FROM node:20.20.2-slim AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build

# Production stage — same-origin SPA and API proxy.  Vite environment values
# are compiled into the static bundle, so a runtime VITE_API_BASE_URL cannot
# point a browser at the backend container.  Nginx serves the bundle and
# proxies /api/ to the private Docker-network backend instead.
FROM nginxinc/nginx-unprivileged:1.29.8-alpine3.23 AS runner

USER root
RUN apk upgrade --no-cache
USER 101

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/ || exit 1
