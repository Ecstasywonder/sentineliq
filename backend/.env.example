# SentinelIQ Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# See docs/git-and-ec2-setup.md for setup instructions.

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
APP_NAME=SentinelIQ
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://sentineliq:changeme@localhost:5432/sentineliq
DATABASE_URL_SYNC=postgresql://sentineliq:changeme@localhost:5432/sentineliq

# =============================================================================
# SECURITY / AUTH
# =============================================================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# PATH B — IBM watsonx Orchestrate SaaS (primary — activates when ORCHESTRATE_URL is set)
# =============================================================================
# Full tenant URL of your watsonx Orchestrate instance.
# Format: https://<tenant>.ibm-watson-orchestrate.com
# Leave empty → falls through to PATH A (watsonx.ai direct).
ORCHESTRATE_URL=
# IBM Cloud API key — used for Orchestrate ZenApiKey auth AND watsonx.ai IAM auth.
ORCHESTRATE_API_KEY=
# Agent IDs as registered in Orchestrate after `orchestrate agents import`
ORCHESTRATE_TRIAGE_AGENT_ID=sentinel_triage_agent
ORCHESTRATE_CONTEXT_AGENT_ID=sentinel_context_agent
ORCHESTRATE_EXPLANATION_AGENT_ID=sentinel_explanation_agent
ORCHESTRATE_COORDINATOR_AGENT_ID=sentinel_coordinator

# =============================================================================
# PATH A — IBM watsonx.ai Chat API (verified fallback — active by default)
# =============================================================================
# Base URL for the watsonx.ai ML API (us-south region — verified 2026-11-05)
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com
# IBM Cloud API key (same as ORCHESTRATE_API_KEY if using the same account)
WATSONX_API_KEY=
# Space ID — MUST have a Watson Machine Learning instance associated.
# Verified: "Orchestrate (Developer edition)" space 5ff3e395-6818-4f50-8123-5c3cd631e691
WATSONX_SPACE_ID=
# Foundation model — verified available and supports text_chat
WATSONX_MODEL_ID=ibm/granite-4-h-small

# =============================================================================
# Agent invocation config
# =============================================================================
AGENT_INVOKE_TIMEOUT=45.0
AGENT_MAX_RETRIES=1

# =============================================================================
# BACKWARDS COMPAT (deprecated — will be removed at Gate 20)
# These map to WATSONX_BASE_URL / WATSONX_SPACE_ID if set.
# =============================================================================
# ORCHESTRATE_BASE_URL=https://us-south.ml.cloud.ibm.com
# ORCHESTRATE_SPACE_ID=5ff3e395-6818-4f50-8123-5c3cd631e691

# =============================================================================
# CORS
# =============================================================================
# Comma-separated string — the config validator splits on commas automatically.
# Do NOT use JSON array format here (pydantic-settings v2 JSON-parses lists
# before the field_validator runs, which causes a parse error on plain strings).
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Leave commented out to use the built-in default above.

# =============================================================================
# EVENT PROCESSING
# =============================================================================
# Deduplication window in seconds
EVENT_DEDUP_WINDOW_SECONDS=300
# Maximum time window for access correlation (minutes)
ACCESS_CORRELATION_WINDOW_MINUTES=10
# Default retrieval limits
MAX_INCIDENT_HISTORY_RESULTS=10
MAX_EVIDENCE_AGE_HOURS=24

# =============================================================================
# RISK ENGINE
# =============================================================================
# Active risk policy version (matches risk_policies table)
ACTIVE_RISK_POLICY_VERSION=1.0

# =============================================================================
# CONFIDENCE ENGINE
# =============================================================================
# Minimum confidence to auto-clear (below this → human review required)
MIN_CONFIDENCE_AUTO_CLEAR=0.85

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_SEMANTIC_SEARCH=true
ENABLE_AGENT_TRACING=true
ENABLE_RATE_LIMITING=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_EVENTS_PER_MINUTE=100
RATE_LIMIT_API_PER_MINUTE=300

# =============================================================================
# OBSERVABILITY
# =============================================================================
ENABLE_STRUCTURED_LOGGING=true
ENABLE_REQUEST_LOGGING=true
# Optional: OpenTelemetry endpoint
OTEL_ENDPOINT=

# =============================================================================
# STORAGE
# =============================================================================
# For thumbnails/media (MVP uses local filesystem)
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_PATH=/app/media
