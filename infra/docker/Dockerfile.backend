# Patch-level base tag; update intentionally with the image-vulnerability
# review rather than inheriting an unreviewed moving `slim` tag.
FROM python:3.11.18-alpine3.23

# Security: run as non-root
RUN addgroup -S -g 1001 sentineliq \
    && adduser -S -D -H -u 1001 -G sentineliq -s /bin/sh sentineliq

WORKDIR /app

# Install system dependencies
RUN apk upgrade --no-cache \
    && apk add --no-cache curl

# Install uv from a versioned release.  Do not copy from the mutable `latest`
# tag because it makes production builds non-reproducible.
COPY --from=ghcr.io/astral-sh/uv:0.6.3 /uv /uvx /usr/local/bin/

# Copy dependency files first (layer caching)
COPY pyproject.toml ./
# Hatchling needs the package directory to install this editable project.
COPY app ./app

# Install only runtime dependencies in the production image.  Test, lint, and
# type-check tools remain CI-only optional dependencies.
RUN uv pip install --system . \
    && uv pip uninstall --system setuptools wheel \
    && uv cache clean

# Copy application code
COPY . .

# Create media directory
RUN mkdir -p /app/media && chown sentineliq:sentineliq /app/media

USER sentineliq

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
