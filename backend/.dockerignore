# Never send runtime credentials or local key material to the image builder.
.env
.env.*
!.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Local tooling, caches, reports, and source-control metadata are not runtime
# inputs and can retain sensitive paths or stale generated content.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
coverage.xml
htmlcov
tests
